# Copy to .env (git-ignored), then replace every value. Local dev only.
# Generate with:  openssl rand -hex 32   (or the one-liner in docs/DEV-SETUP.md)

# Garage internals
GARAGE_RPC_SECRET=<64 hex chars>
GARAGE_ADMIN_TOKEN=<any long random string>

# The S3 access key Readest uses. Garage requires this exact shape:
#   key id  = "GK" + 24 hex chars
#   secret  = 64 hex chars
S3_ACCESS_KEY_ID=GK<24 hex chars>
S3_SECRET_ACCESS_KEY=<64 hex chars>

S3_BUCKET_NAME=kalponik-books
S3_REGION=garage
