# Copy to .env on the server (git-ignored), then fill in every value.
# Generate secrets with:  openssl rand -hex 32

# Public origin, no trailing slash and no path.
KALPONIK_PUBLIC_ORIGIN=https://asroy.duckdns.org

# Docker network the existing nginx-proxy container is on, so it can reach
# kalponik-web and kalponik-garage by name. Find it with:
#   docker inspect <nginx-proxy container> --format '{{json .NetworkSettings.Networks}}'
# On the home server this is `asroy`.
NGINX_PROXY_NETWORK=asroy

# Supabase (hosted project): Project Settings > API, legacy JWT keys.
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<legacy anon key>
SUPABASE_ADMIN_KEY=<legacy service_role key>

# Garage internals (generate fresh ones; don't reuse the local stack's).
GARAGE_RPC_SECRET=<64 hex chars>
GARAGE_ADMIN_TOKEN=<any long random string>

# The S3 access key the web app uses. Garage requires this exact shape:
#   key id  = "GK" + 24 hex chars        (GK$(openssl rand -hex 12))
#   secret  = 64 hex chars               ($(openssl rand -hex 32))
S3_ACCESS_KEY_ID=GK<24 hex chars>
S3_SECRET_ACCESS_KEY=<64 hex chars>
S3_BUCKET_NAME=kalponik-books
S3_REGION=garage

# Where book files live (the big HDD) and Garage's metadata (system disk).
GARAGE_DATA_DIR=/mnt/hdd/kalponik/garage-data
GARAGE_META_DIR=./data/garage-meta
# Capacity Garage may use on that disk.
GARAGE_CAPACITY=300G

# Per-user storage quota shown in the app, in bytes (100 GiB).
STORAGE_FIXED_QUOTA=107374182400

# Host ports on 127.0.0.1 for local checks only (uncommon on purpose).
KALPONIK_WEB_PORT=47811
KALPONIK_S3_PORT=47812

# The web image to run (loaded from the PC with docker load).
KALPONIK_WEB_IMAGE=kalponik-web:latest
