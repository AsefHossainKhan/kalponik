# Copy to .env next to compose.yaml (keep it out of git; chmod 600), then
# replace every placeholder. SELF-HOSTING.md at the repo root explains each key.
# Generate secrets with:  openssl rand -hex 32

# --- Public address ------------------------------------------------------------
# Public origin, no trailing slash and no path. The app is served at
# <origin>/kalponik and book files at <origin>/kalponik-books.
KALPONIK_PUBLIC_ORIGIN=https://your-domain.duckdns.org

# Docker network your reverse proxy container is on, so it can reach
# kalponik-web and kalponik-garage by name. Find it with:
#   docker inspect <proxy container> --format '{{json .NetworkSettings.Networks}}'
# Create one if needed:  docker network create proxy
NGINX_PROXY_NETWORK=proxy

# --- Supabase (hosted project) ------------------------------------------------
# Project Settings > API Keys, "Legacy API keys" tab (the JWT keys).
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=<legacy anon key>
# Secret: full database access. Server only, never in the Android app.
SUPABASE_ADMIN_KEY=<legacy service_role key>

# --- Invite-only sign-up -------------------------------------------------------
# Turn off "Allow new users to sign up" in Supabase > Authentication.
# The root admin(s): they can always open /kalponik/admin to approve access
# requests, make invite links and add more admins, and can't be removed from
# the app. Comma-separated emails or Supabase user ids.
KALPONIK_ADMINS=you@example.com

# --- Email (optional) ----------------------------------------------------------
# The account Kalponik sends from (verification links, "your account is
# ready", admin notices) and its password. For Gmail use an app password
# (16 letters; spaces don't matter). Leave USER and PASS empty to send no
# email at all; sign-up then skips email verification.
KALPONIK_SMTP_USER=
KALPONIK_SMTP_PASS=
# Defaults: smtp.gmail.com on port 465 (TLS from the start; 587 = STARTTLS).
#KALPONIK_SMTP_HOST=smtp.gmail.com
#KALPONIK_SMTP_PORT=465
# Default: "Kalponik <KALPONIK_SMTP_USER>".
#KALPONIK_MAIL_FROM="Kalponik <you@example.com>"

# --- Garage (S3 book storage) --------------------------------------------------
# Internal secrets; generate fresh ones, don't reuse a local test stack's.
#   GARAGE_RPC_SECRET:  openssl rand -hex 32
#   GARAGE_ADMIN_TOKEN: openssl rand -base64 32 | tr -d '=+/'
GARAGE_RPC_SECRET=<64 hex chars>
GARAGE_ADMIN_TOKEN=<any long random string>

# The S3 access key the web app uses. Garage requires this exact shape:
#   key id  = "GK" + 24 hex chars        (GK$(openssl rand -hex 12))
#   secret  = 64 hex chars               ($(openssl rand -hex 32))
S3_ACCESS_KEY_ID=GK<24 hex chars>
S3_SECRET_ACCESS_KEY=<64 hex chars>
# The bucket name is also the public URL path; keep it in step with the
# reverse proxy's location (/kalponik-books/).
S3_BUCKET_NAME=kalponik-books
# Must match s3_region in garage.toml.
S3_REGION=garage

# Where book files live (put this on your big disk) and Garage's small
# metadata database. Docker creates missing folders on the first start.
GARAGE_DATA_DIR=/srv/kalponik/garage-data
GARAGE_META_DIR=./data/garage-meta
# How much of that disk Garage may use.
GARAGE_CAPACITY=100G

# Per-user storage quota shown in the app, in bytes (100 GiB).
STORAGE_FIXED_QUOTA=107374182400

# The public shelf (books every member can read): total size in GB and the
# largest single book in MB. Public books don't count against anyone's quota.
#KALPONIK_PUBLIC_SHELF_QUOTA_GB=50
#KALPONIK_PUBLIC_BOOK_MAX_MB=300

# --- Keep Supabase awake -------------------------------------------------------
# A free Supabase project pauses after a week with too little database
# activity. The web server reads one row through the REST API a minute after
# it starts and then every interval, and logs one line per ping
# (docker logs kalponik-web). "off" turns it off. Interval in hours (1-576).
#KALPONIK_KEEPALIVE=on
#KALPONIK_KEEPALIVE_INTERVAL_HOURS=24

# --- Local ports and image -----------------------------------------------------
# Host ports, bound to 127.0.0.1 only, for check.sh and local debugging.
KALPONIK_WEB_PORT=47811
KALPONIK_S3_PORT=47812

# The web image to run, as loaded with `docker load` (build-web-image.sh
# tags each build kalponik-web:<date>-<commit> and kalponik-web:latest).
# Pin a dated tag to make rollbacks easy.
KALPONIK_WEB_IMAGE=kalponik-web:latest
