NEXT_PUBLIC_APP_PLATFORM=tauri

DBUS_ID=com.kalponik.reader

# --- Kalponik (keep in sync with .env.tauri / .env.web) ---
# Self-hosted: unlocks all features, no store.
NEXT_PUBLIC_SELF_HOSTED=true
# In-app updater on Android only: it reads latest.json from Kalponik's own
# GitHub releases. Off on desktop, where Kalponik ships no builds.
NEXT_PUBLIC_DISABLE_UPDATER=desktop
