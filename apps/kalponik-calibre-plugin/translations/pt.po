msgid_plural "%d in Kalponik"
msgstr[0] "%d no Kalponik"
msgstr[1] "%d no Kalponik"

msgid "%d metadata differs"
msgid_plural "%d metadata differs"
msgstr[0] "%d com metadados diferentes"
msgstr[1] "%d com metadados diferentes"

