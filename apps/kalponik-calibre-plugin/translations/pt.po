msgid "Push selected books and their metadata into your Kalponik cloud library. Re-pushing a book updates its existing entry instead of creating a duplicate."
msgstr "Envie os livros selecionados e os seus metadados para a sua biblioteca na nuvem Kalponik. Reenviar um livro atualiza a entrada existente em vez de criar uma duplicada."

msgid "Not logged in."
msgstr "Sessão não iniciada."

msgid "Include custom columns in pushed metadata"
msgstr "Incluir colunas personalizadas nos metadados enviados"

msgid "Only change this if you run a self-hosted Kalponik server."
msgstr "Altere isto apenas se executar um servidor Kalponik autoalojado."

msgid "Logged in as %s."
msgstr "Sessão iniciada como %s."

msgid "API server:"
msgstr "Servidor de API:"

msgid "Use the Kalponik toolbar menu to log in or out."
msgstr "Use o menu Kalponik da barra de ferramentas para iniciar ou terminar sessão."

msgid "Push to Kalponik"
msgstr "Enviar para o Kalponik"

msgid "Push to Kalponik failed"
msgstr "Falha ao enviar para o Kalponik"

msgid "Kalponik status"
msgstr "Estado do Kalponik"

msgid "Kalponik status check failed"
msgstr "Falha na verificação do estado do Kalponik"

msgid "Log in to Kalponik"
msgstr "Iniciar sessão no Kalponik"

msgid "Email:"
msgstr "E-mail:"

msgid "Password:"
msgstr "Palavra-passe:"

msgid "Log in"
msgstr "Iniciar sessão"

msgid "Logging in…"
msgstr "A iniciar sessão…"

msgid "Waiting for the browser login to complete…"
msgstr "A aguardar a conclusão do início de sessão no navegador…"

msgid "Unknown"
msgstr "Desconhecido"

msgid "Pushing %d book to your Kalponik library…"
msgid_plural "Pushing %d books to your Kalponik library…"
msgstr[0] "A enviar %d livro para a sua biblioteca Kalponik…"
msgstr[1] "A enviar %d livros para a sua biblioteca Kalponik…"

msgid "Checking %d book against your Kalponik library…"
msgid_plural "Checking %d books against your Kalponik library…"
msgstr[0] "A verificar %d livro na sua biblioteca Kalponik…"
msgstr[1] "A verificar %d livros na sua biblioteca Kalponik…"

msgid "Or sign in with your browser:"
msgstr "Ou inicie sessão com o seu navegador:"

msgid "Please enter both email and password."
msgstr "Introduza o e-mail e a palavra-passe."

msgid "Login failed: the browser callback carried no session."
msgstr "Falha ao iniciar sessão: a resposta do navegador não trouxe nenhuma sessão."

msgid "Book"
msgstr "Livro"

msgid "Status"
msgstr "Estado"

msgid "Details"
msgstr "Detalhes"

msgid "Canceling…"
msgstr "A cancelar…"

msgid "Browser login timed out. Try again."
msgstr "O início de sessão no navegador expirou. Tente novamente."

msgid "Login failed: %s"
msgstr "Falha ao iniciar sessão: %s"

msgid "Kalponik Login"
msgstr "Início de sessão no Kalponik"

msgid "Completing login…"
msgstr "A concluir o início de sessão…"

msgid "Login complete. You can close this tab and return to calibre."
msgstr "Início de sessão concluído. Pode fechar este separador e voltar ao calibre."

msgid "Kalponik"
msgstr "Kalponik"

msgid "Push selected books and metadata to your Kalponik library"
msgstr "Enviar os livros selecionados e os metadados para a sua biblioteca Kalponik"

msgid "Select the books to push to Kalponik."
msgstr "Selecione os livros a enviar para o Kalponik."

msgid "Select the books to check against Kalponik."
msgstr "Selecione os livros a verificar no Kalponik."

msgid "No books selected"
msgstr "Nenhum livro selecionado"

msgid "Push selected books to Kalponik"
msgstr "Enviar os livros selecionados para o Kalponik"

msgid "Check Kalponik status"
msgstr "Verificar o estado do Kalponik"

msgid "Log in to Kalponik…"
msgstr "Iniciar sessão no Kalponik…"

msgid "Log out"
msgstr "Terminar sessão"

msgid "Customize plugin…"
msgstr "Personalizar o plugin…"

msgid "Log out (%s)"
msgstr "Terminar sessão (%s)"

msgid "your Kalponik account"
msgstr "a sua conta Kalponik"

msgid "Uploaded"
msgstr "Enviado"

msgid "Replaced"
msgstr "Substituído"

msgid "Updated"
msgstr "Atualizado"

msgid "Up to date"
msgstr "Em dia"

msgid "Failed"
msgstr "Falhou"

msgid "In Kalponik"
msgstr "No Kalponik"

msgid "Metadata differs"
msgstr "Metadados diferentes"

msgid "Out of date"
msgstr "Desatualizado"

msgid "Not in Kalponik"
msgstr "Não está no Kalponik"

msgid "No Kalponik-supported format (EPUB, PDF, ...)"
msgstr "Nenhum formato suportado pelo Kalponik (EPUB, PDF, ...)"

msgid "Book file is missing from the calibre library"
msgstr "O ficheiro do livro não está na biblioteca do calibre"

msgid "Nothing to push."
msgstr "Nada para enviar."

msgid "Nothing to check."
msgstr "Nada para verificar."

msgid "Please log in to Kalponik first. (%s)"
msgstr "Inicie sessão no Kalponik primeiro. (%s)"

msgid "Could not reach Kalponik: %s"
msgstr "Não foi possível contactar o Kalponik: %s"

msgid "Canceled."
msgstr "Cancelado."

msgid "Kalponik storage quota exceeded — push stopped."
msgstr "Quota de armazenamento do Kalponik excedida — envio interrompido."

msgid "Session expired — please log in again."
msgstr "Sessão expirada — inicie sessão novamente."

msgid "Login failed"
msgstr "Falha ao iniciar sessão"

msgid "Not logged in"
msgstr "Sessão não iniciada"

msgid "Session expired, please log in again"
msgstr "Sessão expirada, inicie sessão novamente"

msgid "Not authenticated"
msgstr "Não autenticado"

msgid "Request failed (%s)"
msgstr "O pedido falhou (%s)"

msgid "Upload failed (%s)"
msgstr "O envio falhou (%s)"

msgid "%d uploaded"
msgid_plural "%d uploaded"
msgstr[0] "%d enviado"
msgstr[1] "%d enviados"

msgid "%d replaced"
msgid_plural "%d replaced"
msgstr[0] "%d substituído"
msgstr[1] "%d substituídos"

msgid "%d updated"
msgid_plural "%d updated"
msgstr[0] "%d atualizado"
msgstr[1] "%d atualizados"

